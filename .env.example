# Common settings for all containers. Nothing secret here.

ROS_DISTRO=jazzy
ROS_DOMAIN_ID=42

# rmw_zenoh_cpp (default) or rmw_cyclonedds_cpp
RMW_IMPLEMENTATION=rmw_zenoh_cpp

# Gazebo transport partition, keeps this simulation separate from any other gz instance
GZ_PARTITION=auv_sim

# Visualisation
NOVNC_PORT=6080
FOXGLOVE_PORT=8765
VNC_RESOLUTION=1600x900
# Gazebo GUI is the heaviest window on CPU rendering, make it false if the desktop is slow
START_GZ_GUI=true
START_RVIZ=true
