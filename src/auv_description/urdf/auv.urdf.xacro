<?xml version="1.0"?>
<!--
  Kinematic description of the torpedo AUV for TF and RViz. Dynamics are in
  auv_sim/models/auv/model.sdf.xacro. Mesh is the MBARI Tethys LRAUV (Gazebo
  Fuel, CC-BY 4.0), it is having the tail on +x, so it is turned by 180 deg to
  get x forward as per REP-103.
-->
<robot name="auv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.14159265"/>
      <geometry>
        <mesh filename="package://auv_sim/models/auv/meshes/tethys.dae"/>
      </geometry>
    </visual>
  </link>

  <!-- sensor frames, poses are same as in auv_sim/models/auv/model.sdf.xacro -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- DVL velocity is in dvl_link (body axes), beams are traced in dvl_beams_link (x down) -->
  <link name="dvl_link"/>
  <joint name="dvl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="dvl_link"/>
    <origin xyz="0.3 0 -0.15" rpy="0 0 0"/>
  </joint>

  <link name="dvl_beams_link"/>
  <joint name="dvl_beams_joint" type="fixed">
    <parent link="base_link"/>
    <child link="dvl_beams_link"/>
    <origin xyz="0.3 0 -0.15" rpy="0 1.5708 0"/>
  </joint>

  <!-- GPS antenna on the top of the hull, out of water only at the surface -->
  <link name="gps_link"/>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.2 0 0.18" rpy="0 0 0"/>
  </joint>

  <link name="sonar_link"/>
  <joint name="sonar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sonar_link"/>
    <origin xyz="0.70 0 -0.08" rpy="0 0.5236 0"/>
  </joint>

</robot>
