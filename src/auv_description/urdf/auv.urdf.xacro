<?xml version="1.0"?>
<!-- Kinematic description for TF and RViz. Dynamics are in auv_sim/models/auv. -->
<robot name="auv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="thrusters_file" default="$(find auv_description)/config/thrusters.yaml"/>
  <xacro:property name="cfg" value="${xacro.load_yaml('$(arg thrusters_file)')}"/>

  <material name="frame_blue"><color rgba="0.05 0.25 0.6 1.0"/></material>
  <material name="foam_yellow"><color rgba="0.95 0.75 0.1 1.0"/></material>
  <material name="thruster_black"><color rgba="0.1 0.1 0.1 1.0"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry><box size="0.44 0.30 0.12"/></geometry>
      <material name="frame_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry><box size="0.44 0.34 0.07"/></geometry>
      <material name="foam_yellow"/>
    </visual>
  </link>

  <xacro:macro name="thruster" params="name xyz rpy">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="0.045" length="0.06"/></geometry>
        <material name="thruster_black"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${xyz[0]} ${xyz[1]} ${xyz[2]}" rpy="${rpy[0]} ${rpy[1]} ${rpy[2]}"/>
    </joint>
  </xacro:macro>

  <!-- xacro is not having a for loop, so going with recursion over the yaml list -->
  <xacro:macro name="thruster_loop" params="i">
    <xacro:if value="${i &lt; len(cfg['thrusters'])}">
      <xacro:property name="t" value="${cfg['thrusters'][i]}"/>
      <xacro:thruster name="${t['name']}" xyz="${t['xyz']}" rpy="${t['rpy']}"/>
      <xacro:thruster_loop i="${i + 1}"/>
    </xacro:if>
  </xacro:macro>
  <xacro:thruster_loop i="0"/>

</robot>
