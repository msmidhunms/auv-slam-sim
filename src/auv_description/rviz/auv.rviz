Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Splitter Ratio: 0.6
    Tree Height: 330
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Water surface
      Enabled: true
      Reference Frame: map
      Plane: XY
      Plane Cell Count: 28
      Cell Size: 10
      Color: 70; 130; 170
      Alpha: 0.25
    - Class: rviz_default_plugins/RobotModel
      Name: Vehicle
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Bathymetry map (SLAM)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/cloud_map
      Style: Flat Squares
      Size (m): 0.6
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Use Fixed Frame: true
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Multibeam swath
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /multibeam/swath
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Decay Time: 8
    - Class: rviz_default_plugins/PointCloud2
      Name: Forward looking sonar
      Enabled: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sonar/points
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 120; 0
      Decay Time: 0
    - Class: rviz_default_plugins/Path
      Name: Mission plan
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mission/path
      Color: 255; 255; 0
      Line Style: Lines
    - Class: rviz_default_plugins/Path
      Name: SLAM trajectory
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/mapPath
      Color: 255; 60; 200
      Line Style: Lines
    - Class: rviz_default_plugins/Odometry
      Name: Navigation (USBL aided)
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/global
      Keep: 600
      Position Tolerance: 2.0
      Angle Tolerance: 1.0
      Shape:
        Value: Arrow
        Color: 80; 160; 255
        Shaft Length: 1.0
        Shaft Radius: 0.08
        Head Length: 0.4
        Head Radius: 0.2
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Odometry
      Name: Ground truth
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ground_truth/odom
      Keep: 600
      Position Tolerance: 2.0
      Angle Tolerance: 1.0
      Shape:
        Value: Arrow
        Color: 50; 220; 90
        Shaft Length: 1.0
        Shaft Radius: 0.08
        Head Length: 0.4
        Head Radius: 0.2
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Odometry
      Name: Dead reckoning
      Enabled: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/filtered
      Keep: 600
      Position Tolerance: 2.0
      Angle Tolerance: 1.0
      Shape:
        Value: Arrow
        Color: 255; 170; 0
        Shaft Length: 1.0
        Shaft Radius: 0.08
        Head Length: 0.4
        Head Radius: 0.2
      Covariance:
        Value: false
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: USBL fixes
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /usbl/pose
      Shape: Axes
      Axes Length: 0.5
      Axes Radius: 0.1
      Covariance:
        Value: true
        Position:
          Value: true
          Color: 255; 90; 90
          Alpha: 0.4
          Scale: 2
        Orientation:
          Value: false
    - Class: rviz_default_plugins/PointStamped
      Name: Support ship (USBL)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /usbl/ship
      Color: 255; 90; 90
      Radius: 2.0
      History Length: 1
    - Class: rviz_default_plugins/Image
      Name: Sidescan
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sidescan/waterfall
      Normalize Range: false
  Enabled: true
  Global Options:
    Background Color: 8; 26; 40
    Fixed Frame: map
    Frame Rate: 10
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_link
      Distance: 45
      Pitch: 0.55
      Yaw: 3.6
      Focal Point:
        X: 0
        Y: 0
        Z: -8
      Near Clip Distance: 0.1
Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: true
  Sidescan:
    collapsed: false
  Height: 900
  Width: 800
