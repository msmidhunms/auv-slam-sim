<?xml version="1.0"?>
<!--
  Survey area: 300 x 300 m of sandy seabed around 40 m depth, with rock fields,
  a pipeline and a ship wreck. Water surface is at z = 0. The vehicle starts at
  the surface, like a real AUV after launch from the ship.
-->
<sdf version="1.10">
  <world name="underwater">

    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <!-- rendering sensors (sonars). Server is started with headless rendering -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- water below z = 0, air above, so the vehicle floats at the surface -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <enable>auv</enable>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <!-- dim blue green light, like at 30 to 40 m depth in coastal water -->
    <scene>
      <ambient>0.18 0.30 0.34 1</ambient>
      <background>0.0 0.10 0.15 1</background>
      <grid>false</grid>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.45 0.62 0.68 1</diffuse>
      <specular>0.05 0.06 0.06 1</specular>
      <direction>-0.2 0.1 -1.0</direction>
    </light>

    <include>
      <uri>model://seabed</uri>
    </include>

    <include>
      <uri>model://seabed_features</uri>
    </include>

    <include>
      <uri>model://auv</uri>
      <pose>0 0 -0.3 0 0 0</pose>
    </include>

  </world>
</sdf>
