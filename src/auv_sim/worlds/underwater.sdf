<?xml version="1.0"?>
<!--
  Underwater world: water surface is at z = 0, seabed is around z = -10.
  A pipeline, a wreck and some rocks are kept on the seabed so that the sonar
  is having enough structure for scan matching.
-->
<sdf version="1.10">
  <world name="underwater">

    <!-- 4 ms step is sufficient for this vehicle and gives headroom on CPU -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!--
      Water below z = 0 and air above it, so the vehicle stops at the surface
      instead of flying off. Enabled only for the vehicle, static models are
      not needing it.
    -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <enable>auv</enable>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.25 0.4 0.5 1</ambient>
      <background>0.02 0.12 0.2 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.7 0.8 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <include>
      <uri>model://seabed</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://auv</uri>
      <pose>0 0 -2 0 0 0</pose>
    </include>

    <!-- ================= seabed structures ================= -->

    <model name="pipeline">
      <static>true</static>
      <pose>8 -5 -9.4 0 1.5708 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.35</radius><length>40</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>40</length></cylinder></geometry>
          <material><ambient>0.35 0.3 0.25 1</ambient><diffuse>0.4 0.33 0.27 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wreck">
      <static>true</static>
      <pose>-12 10 -9.2 0.15 0.05 -0.6</pose>
      <link name="link">
        <collision name="hull_collision">
          <geometry><box><size>12 3.2 2.2</size></box></geometry>
        </collision>
        <visual name="hull_visual">
          <geometry><box><size>12 3.2 2.2</size></box></geometry>
          <material><ambient>0.3 0.22 0.18 1</ambient><diffuse>0.35 0.25 0.2 1</diffuse></material>
        </visual>
        <collision name="cabin_collision">
          <pose>-3 0 1.9 0 0 0</pose>
          <geometry><box><size>3 2.4 1.6</size></box></geometry>
        </collision>
        <visual name="cabin_visual">
          <pose>-3 0 1.9 0 0 0</pose>
          <geometry><box><size>3 2.4 1.6</size></box></geometry>
          <material><ambient>0.32 0.25 0.2 1</ambient><diffuse>0.38 0.28 0.22 1</diffuse></material>
        </visual>
        <collision name="mast_collision">
          <pose>2 0 3.1 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>4</length></cylinder></geometry>
        </collision>
        <visual name="mast_visual">
          <pose>2 0 3.1 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>4</length></cylinder></geometry>
          <material><ambient>0.25 0.2 0.18 1</ambient><diffuse>0.3 0.23 0.2 1</diffuse></material>
        </visual>
        <collision name="bow_collision">
          <pose>6.6 0 0.2 0 -0.5 0</pose>
          <geometry><box><size>2.5 2.4 1.6</size></box></geometry>
        </collision>
        <visual name="bow_visual">
          <pose>6.6 0 0.2 0 -0.5 0</pose>
          <geometry><box><size>2.5 2.4 1.6</size></box></geometry>
          <material><ambient>0.3 0.22 0.18 1</ambient><diffuse>0.35 0.25 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rocks">
      <static>true</static>
      <link name="link">
        <collision name="rock1_collision">
          <pose>5 8 -9.3 0 0 0.3</pose>
          <geometry><ellipsoid><radii>1.6 1.1 0.9</radii></ellipsoid></geometry>
        </collision>
        <visual name="rock1_visual">
          <pose>5 8 -9.3 0 0 0.3</pose>
          <geometry><ellipsoid><radii>1.6 1.1 0.9</radii></ellipsoid></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.38 0.38 0.36 1</diffuse></material>
        </visual>

        <collision name="rock2_collision">
          <pose>14 6 -9.0 0.2 0 1.1</pose>
          <geometry><ellipsoid><radii>2.2 1.5 1.3</radii></ellipsoid></geometry>
        </collision>
        <visual name="rock2_visual">
          <pose>14 6 -9.0 0.2 0 1.1</pose>
          <geometry><ellipsoid><radii>2.2 1.5 1.3</radii></ellipsoid></geometry>
          <material><ambient>0.28 0.28 0.3 1</ambient><diffuse>0.35 0.35 0.37 1</diffuse></material>
        </visual>

        <collision name="rock3_collision">
          <pose>-4 -9 -9.6 0 0 0</pose>
          <geometry><sphere><radius>1.0</radius></sphere></geometry>
        </collision>
        <visual name="rock3_visual">
          <pose>-4 -9 -9.6 0 0 0</pose>
          <geometry><sphere><radius>1.0</radius></sphere></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.38 0.36 1</diffuse></material>
        </visual>

        <collision name="rock4_collision">
          <pose>-15 -6 -9.2 0.3 0.2 0.7</pose>
          <geometry><box><size>2.5 1.8 1.6</size></box></geometry>
        </collision>
        <visual name="rock4_visual">
          <pose>-15 -6 -9.2 0.3 0.2 0.7</pose>
          <geometry><box><size>2.5 1.8 1.6</size></box></geometry>
          <material><ambient>0.27 0.27 0.27 1</ambient><diffuse>0.34 0.34 0.33 1</diffuse></material>
        </visual>

        <collision name="rock5_collision">
          <pose>18 -14 -9.0 0 0.2 2.0</pose>
          <geometry><ellipsoid><radii>1.9 1.9 1.4</radii></ellipsoid></geometry>
        </collision>
        <visual name="rock5_visual">
          <pose>18 -14 -9.0 0 0.2 2.0</pose>
          <geometry><ellipsoid><radii>1.9 1.9 1.4</radii></ellipsoid></geometry>
          <material><ambient>0.3 0.29 0.28 1</ambient><diffuse>0.37 0.36 0.34 1</diffuse></material>
        </visual>

        <collision name="rock6_collision">
          <pose>0 16 -9.4 0.4 0 0.2</pose>
          <geometry><box><size>1.4 2.2 1.2</size></box></geometry>
        </collision>
        <visual name="rock6_visual">
          <pose>0 16 -9.4 0.4 0 0.2</pose>
          <geometry><box><size>1.4 2.2 1.2</size></box></geometry>
          <material><ambient>0.29 0.28 0.27 1</ambient><diffuse>0.36 0.35 0.33 1</diffuse></material>
        </visual>

        <collision name="rock7_collision">
          <pose>-8 -18 -9.1 0 0 0</pose>
          <geometry><sphere><radius>1.5</radius></sphere></geometry>
        </collision>
        <visual name="rock7_visual">
          <pose>-8 -18 -9.1 0 0 0</pose>
          <geometry><sphere><radius>1.5</radius></sphere></geometry>
          <material><ambient>0.3 0.3 0.31 1</ambient><diffuse>0.38 0.38 0.39 1</diffuse></material>
        </visual>

        <collision name="rock8_collision">
          <pose>10 -18 -9.5 0 0.3 1.4</pose>
          <geometry><ellipsoid><radii>1.2 0.8 0.7</radii></ellipsoid></geometry>
        </collision>
        <visual name="rock8_visual">
          <pose>10 -18 -9.5 0 0.3 1.4</pose>
          <geometry><ellipsoid><radii>1.2 0.8 0.7</radii></ellipsoid></geometry>
          <material><ambient>0.28 0.28 0.28 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
